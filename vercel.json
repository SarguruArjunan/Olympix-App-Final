{
  "version": 2,
  "buildCommand": "npm install && cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install && cd frontend && npm ci",
  "devCommand": "cd frontend && npm start",
  "framework": "create-react-app",
  "env": {
    "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/"
  },
  "build": {
    "env": {
      "REACT_APP_API_BASE_URL": "https://olympix-app-final.vercel.app/api/v1"
    }
  },
  "functions": {
    "api/server.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/server?path=$1"
    }
  ]
}