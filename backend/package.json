{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for Olympics-style web application",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "convert-excel": "ts-node src/utils/excel-to-json-converter.ts",
    "create-sample-data": "ts-node src/utils/excel-to-json-converter.ts --sample",
    "validate-data": "ts-node -e \"require('./src/services/json.service.ts').JsonService.validateDataFiles().then((result: boolean) => console.log('Validation:', result ? 'PASSED' : 'FAILED'))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^18.19.111",
    "@types/proper-lockfile": "^4.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "proper-lockfile": "^4.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.41.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
